{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      ".firebaserc",
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      ".firebase",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/content.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/admin",
        "destination": "https://heebonyang.web.app/admin",
        "type": 301
      },
      {
        "source": "/admin/",
        "destination": "https://heebonyang.web.app/admin",
        "type": 301
      },
      {
        "source": "/admin.html",
        "destination": "https://heebonyang.web.app/admin",
        "type": 301
      }
    ]
  }
}
